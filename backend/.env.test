NODE_ENV=test
PORT=3000

# PostgreSQL (docker compose up -d desde la raíz del proyecto)
DB_HOST=localhost
DB_PORT=5433
DB_USER=psicotoando
DB_PASSWORD=psicotoando
DB_NAME=psicotoando_test

# Genera uno propio: openssl rand -base64 48
JWT_ACCESS_SECRET=test-secret-that-is-long-enough-for-validation
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
# true en producción (HTTPS)
COOKIE_SECURE=false

FRONTEND_URL=http://localhost:4200
# ID de cliente OAuth de Google (tipo «Aplicación web»). Vacío = botón de Google oculto.
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com

# En local, Mailpit recibe los correos: http://localhost:8025
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Psico T.O ando <no-reply@psicotoando.local>"
