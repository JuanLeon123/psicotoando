NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose up -d desde la raíz del proyecto)
DB_HOST=localhost
DB_PORT=5433
DB_USER=psicotoando
DB_PASSWORD=psicotoando
DB_NAME=psicotoando

# Genera uno propio: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
# true en producción (HTTPS)
COOKIE_SECURE=false

FRONTEND_URL=http://localhost:4200
# ID de cliente OAuth de Google (tipo «Aplicación web»). Vacío = botón de Google oculto.
GOOGLE_CLIENT_ID=

# En local, Mailpit recibe los correos: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Psico T.O ando <no-reply@psicotoando.local>"

# Cuenta fija del panel de administración (se crea o actualiza al arrancar).
# La contraseña solo se cambia aquí: mínimo 12 caracteres. Vacío = sin administrador.
ADMIN_EMAIL=admin@psicotoando.com
ADMIN_PASSWORD=
ADMIN_NAME=Administración
# Carpeta donde se guardan las imágenes de productos subidas desde el panel.
UPLOADS_DIR=uploads

# Wompi (pasarela de pagos). Copia las llaves desde el panel de Wompi > Desarrolladores.
# Vacío = la tienda no ofrece pago en línea. sandbox = pruebas, production = dinero real.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
